# ── Orellius Production Environment ──────────────────────────
# Copy this to .env.production and fill in the values

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Channels
TARGET_CHANNEL=
SOURCE_CHANNELS=

# Database
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://orellius:${POSTGRES_PASSWORD}@localhost:5432/orellius

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://localhost:6379

# Security
API_SECRET_TOKEN=generate_a_strong_random_token_here

# Observability
SENTRY_DSN=

# Stripe (optional, for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
