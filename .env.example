# ── Telegram API ──
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone is optional here — the onboarding wizard will prompt for it
# TELEGRAM_PHONE=+1XXXXXXXXXX
TELEGRAM_SESSION_NAME=myapp_session

# ── Channels ──
SOURCE_CHANNELS=@channel1,@channel2
TARGET_CHANNEL=@my_output_channel

# ── Database ──
POSTGRES_PASSWORD=CHANGE_ME_TO_RANDOM_STRING
DATABASE_URL=postgresql+asyncpg://tcm:CHANGE_ME_TO_RANDOM_STRING@localhost:5432/tcm

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Qdrant ──
QDRANT_URL=http://localhost:6333

# ── Ollama (Local LLM) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TRANSLATOR=qwen2.5:32b
OLLAMA_MODEL_ORCHESTRATOR=llama3.3:70b
OLLAMA_MODEL_REVIEWER=deepseek-r1:32b
OLLAMA_MODEL_DAEMON=qwen2.5-coder:32b

# ── Publishing ──
PUBLISH_DELAY_SECONDS=30
AUTO_PUBLISH=false

# ── Media ──
STAMP_ENABLED=true
STAMP_IMAGE_PATH=assets/stamps/watermark.png

# ── WebSocket ──
WS_HOST=127.0.0.1
WS_PORT=8765
